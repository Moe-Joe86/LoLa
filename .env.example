# Einstellungen für LoLa. Kopie als `.env` anlegen und dort ändern. Keine Geheimnisse in diese Datei.

# Ordner außerhalb des Repos mit llama.cpp, speech-to-speech, Modellen und Stimmdaten
LOLA_LAUFZEIT=~/lola-laufzeit
# Sprachmodell, Pfad innerhalb des Laufzeit-Ordners
LOLA_SPRACHMODELL=modelle/Qwen3-8B-Q4_K_M.gguf
# Stimmdaten in <Laufzeit>/stimmen/, Name ohne Endung (.spk und .rvq)
LOLA_STIMME=frau_0.6B-Base_Q8_0
# Name oder IP-Adresse des Reachy im Heimnetz
LOLA_REACHY=reachy-mini.local
# Profil der Conversation App, ein Ordner in charakter/profile/
LOLA_PROFIL=lola_deutsch
# Das Anfrage-Log (daten/anfragen-*.jsonl) enthält Gesagtes der Familie. Nach so vielen Tagen wird es gelöscht.
LOLA_ANFRAGE_LOG_TAGE=7
